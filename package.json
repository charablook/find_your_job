{
  "name": "services-quebec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock supabase start",
    "db:stop": "DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock supabase stop",
    "db:status": "DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock supabase status",
    "db:migrate": "DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock supabase migration up"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
